      "name": "STT-Suite",
      "repo": "STT-Suite",
      "speech": "the service itself",
      "badge": {
        "kind": "source",
        "uses": "ui/test.js and ui/dictation-mic.js (the page's test dictation) read ui/badge/ itself"
      }
    },
    {
      "name": "TTS-Suite",
      "repo": "TTS-Suite",
      "speaker": {
        "kind": "source",
        "uses": "src/tts_suite/service/ui/speak.js and speaker-icon.js (the page's test reading) read speaker/ itself"
      }
    },
    {
